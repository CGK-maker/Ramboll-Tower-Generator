<tsd:PluginWindowBase
    x:Class="RambollTowerGenerator.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tsd="clr-namespace:Tekla.Structures.Dialog;assembly=Tekla.Structures.Dialog"
    xmlns:UIControls="clr-namespace:Tekla.Structures.Dialog.UIControls;assembly=Tekla.Structures.Dialog"
    Title="Ramboll Tower Generator"
    Width="800"
    Height="600"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent">

    <Grid>
        <Border CornerRadius="15"
                Background="White"
                BorderBrush="#CCCCCC"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="5"
                                  Opacity="0.3"
                                  Color="Black" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="#0078D4"
                        CornerRadius="15,15,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Ramboll Tower Generator"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0" />

                        <Button Grid.Column="1"
                                Content="—"
                                FontSize="16"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="MinimizeButton_Click" />

                        <Button Grid.Column="2"
                                Content="□"
                                FontSize="20"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="MaximizeRestoreButton_Click" />

                        <Button Grid.Column="3"
                                Content="✕"
                                FontSize="16"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="CloseButton_Click" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="10,10,10,0">
                    <TabControl SelectedIndex="2">
                        <TabItem Header="Picture">
                            <Grid Margin="10">
                                <TextBlock Text="Picture content goes here."
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="#666666" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="Part">
                            <Grid Margin="10">
                                <TextBlock Text="Part content goes here."
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="#666666" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="Leg Parameters">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <GroupBox Header="Tower Configuration"
                                              Margin="0,0,0,10"
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              Width="736">
                                        <StackPanel Margin="10">
                                            <Grid Margin="0,0,0,6">
                                                <StackPanel>
                                                    <Label Content="Tower Type"
                                                           Height="28"
                                                           FontSize="13" />
                                                    <ComboBox Width="200"
                                                              Height="30"
                                                              HorizontalAlignment="Left"
                                                              SelectedIndex="{Binding TowerType, Mode=TwoWay}"
                                                              FontSize="13">
                                                        <ComboBoxItem Content="3 Leg Tower" />
                                                        <ComboBoxItem Content="4 Leg Tower" />
                                                    </ComboBox>

                                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,6">
                                                        <Label Width="120" Height="30" Content="Base Width" />
                                                        <TextBox Width="120"
                                                                 Height="23"
                                                                 VerticalAlignment="Center"
                                                                 Text="{Binding BaseWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <Label Width="120" Height="30" Content="Top Width" />
                                                        <TextBox Width="120"
                                                                 Height="23"
                                                                 VerticalAlignment="Center"
                                                                 Text="{Binding TopWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <Label Width="120" Height="30" Content="Segments" />
                                                        <TextBox Width="120"
                                                                 Height="23"
                                                                 VerticalAlignment="Center"
                                                                 Text="{Binding SegmentCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                        <Label Width="120" Height="30" Content="Total Height" />
                                                        <TextBox Width="120"
                                                                 Height="23"
                                                                 VerticalAlignment="Center"
                                                                 Text="{Binding TotalHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                        <Label Width="120" Height="30" Content="Segment Gap" />
                                                        <TextBox Width="120"
                                                                 Height="23"
                                                                 VerticalAlignment="Center"
                                                                 Text="{Binding SegmentGap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Label Width="120"
                                                       Height="30"
                                                       VerticalAlignment="Center"
                                                       Content="Profile" />
                                                <UIControls:WpfFilterCheckBox Width="24"
                                                                              VerticalAlignment="Center"
                                                                              AttributeName="profile" />
                                                <TextBox Width="120"
                                                         Height="23"
                                                         Margin="6,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Text="{Binding Profilename, Mode=TwoWay}"
                                                         TextWrapping="Wrap" />
                                                <UIControls:WpfProfileCatalog x:Name="profileCatalog"
                                                                              VerticalAlignment="Center"
                                                                              SelectClicked="profileCatalog_SelectClicked"
                                                                              SelectionDone="profileCatalog_SelectionDone" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Label Width="120"
                                                       Height="30"
                                                       VerticalAlignment="Center"
                                                       Content="Material" />
                                                <UIControls:WpfFilterCheckBox Width="24"
                                                                              VerticalAlignment="Center"
                                                                              AttributeName="material" />
                                                <TextBox x:Name="materialBox"
                                                         Width="120"
                                                         Height="23"
                                                         Margin="6,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Text="{Binding Material, Mode=TwoWay}"
                                                         TextWrapping="Wrap" />
                                                <UIControls:WpfMaterialCatalog x:Name="materialCatalog"
                                                                               VerticalAlignment="Center"
                                                                               BorderThickness="0"
                                                                               FontSize="6"
                                                                               SelectClicked="WPFMaterialCatalog_SelectClicked"
                                                                               SelectionDone="WPFMaterialCatalog_SelectionDone" />
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Tower Parameters">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <GroupBox Header="Cage Parameters"
                                              Margin="0,0,0,10"
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              Width="736">
                                        <StackPanel Margin="10">
                                            <Label Content="Cage Type"
                                                   Height="28"
                                                   FontSize="13" />
                                            <ComboBox Width="220"
                                                      Height="30"
                                                      HorizontalAlignment="Left"
                                                      SelectedIndex="{Binding CageType, Mode=TwoWay}">
                                                <ComboBoxItem Content="Conical" />
                                                <ComboBoxItem Content="Vertical" />
                                                <ComboBoxItem Content="Conical + Vertical" />
                                            </ComboBox>

                                            <StackPanel Margin="0,8,0,0"
                                                        IsEnabled="{Binding IsConicalVerticalSelected}">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Label Width="120" Height="30" Content="Vertical Height" />
                                                    <TextBox Width="120"
                                                             Height="23"
                                                             VerticalAlignment="Center"
                                                             Text="{Binding VerticalHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal">
                                                    <Label Width="120" Height="30" Content="Vertical Segments" />
                                                    <TextBox Width="120"
                                                             Height="23"
                                                             VerticalAlignment="Center"
                                                             Text="{Binding VerticalSegmentCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Twin Profiles">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <GroupBox Header="Bracing Configuration"
                                              Margin="0,0,0,10"
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              Width="736">
                                        <StackPanel Margin="10">
                                            <Label Content="Bracing Type"
                                                   Height="28"
                                                   FontSize="13" />
                                            <ComboBox Width="220"
                                                      Height="30"
                                                      HorizontalAlignment="Left"
                                                      SelectedIndex="{Binding BracingType, Mode=TwoWay}"
                                                      FontSize="13"
                                                      Margin="0,0,0,10">
                                                <ComboBoxItem Content="None" />
                                                <ComboBoxItem Content="X Bracing" />
                                            </ComboBox>

                                            <StackPanel IsEnabled="{Binding IsBracingEnabled}">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Label Width="150"
                                                           Height="30"
                                                           VerticalAlignment="Center"
                                                           Content="Diagonal Profile" />
                                                    <UIControls:WpfFilterCheckBox Width="24"
                                                                                  VerticalAlignment="Center"
                                                                                  AttributeName="diagprofile" />
                                                    <TextBox Width="120"
                                                             Height="23"
                                                             Margin="6,0,6,0"
                                                             VerticalAlignment="Center"
                                                             Text="{Binding DiagonalProfile, Mode=TwoWay}"
                                                             TextWrapping="Wrap" />
                                                    <UIControls:WpfProfileCatalog x:Name="diagonalProfileCatalog"
                                                                                  VerticalAlignment="Center"
                                                                                  SelectClicked="diagonalProfileCatalog_SelectClicked"
                                                                                  SelectionDone="diagonalProfileCatalog_SelectionDone" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Label Width="150"
                                                           Height="30"
                                                           VerticalAlignment="Center"
                                                           Content="Diagonal Material" />
                                                    <UIControls:WpfFilterCheckBox Width="24"
                                                                                  VerticalAlignment="Center"
                                                                                  AttributeName="diagmaterial" />
                                                    <TextBox Width="120"
                                                             Height="23"
                                                             Margin="6,0,6,0"
                                                             VerticalAlignment="Center"
                                                             Text="{Binding DiagonalMaterial, Mode=TwoWay}"
                                                             TextWrapping="Wrap" />
                                                    <UIControls:WpfMaterialCatalog x:Name="diagonalMaterialCatalog"
                                                                                   VerticalAlignment="Center"
                                                                                   BorderThickness="0"
                                                                                   FontSize="6"
                                                                                   SelectClicked="diagonalMaterialCatalog_SelectClicked"
                                                                                   SelectionDone="diagonalMaterialCatalog_SelectionDone" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Label Width="150"
                                                           Height="30"
                                                           VerticalAlignment="Center"
                                                           Content="Horizontal Profile" />
                                                    <UIControls:WpfFilterCheckBox Width="24"
                                                                                  VerticalAlignment="Center"
                                                                                  AttributeName="horizprofile" />
                                                    <TextBox Width="120"
                                                             Height="23"
                                                             Margin="6,0,6,0"
                                                             VerticalAlignment="Center"
                                                             Text="{Binding HorizontalProfile, Mode=TwoWay}"
                                                             TextWrapping="Wrap" />
                                                    <UIControls:WpfProfileCatalog x:Name="horizontalProfileCatalog"
                                                                                  VerticalAlignment="Center"
                                                                                  SelectClicked="horizontalProfileCatalog_SelectClicked"
                                                                                  SelectionDone="horizontalProfileCatalog_SelectionDone" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <Label Width="150"
                                                           Height="30"
                                                           VerticalAlignment="Center"
                                                           Content="Horizontal Material" />
                                                    <UIControls:WpfFilterCheckBox Width="24"
                                                                                  VerticalAlignment="Center"
                                                                                  AttributeName="horizmaterial" />
                                                    <TextBox Width="120"
                                                             Height="23"
                                                             Margin="6,0,6,0"
                                                             VerticalAlignment="Center"
                                                             Text="{Binding HorizontalMaterial, Mode=TwoWay}"
                                                             TextWrapping="Wrap" />
                                                    <UIControls:WpfMaterialCatalog x:Name="horizontalMaterialCatalog"
                                                                                   VerticalAlignment="Center"
                                                                                   BorderThickness="0"
                                                                                   FontSize="6"
                                                                                   SelectClicked="horizontalMaterialCatalog_SelectClicked"
                                                                                   SelectionDone="horizontalMaterialCatalog_SelectionDone" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Label Width="150" Height="30" Content="Bracing Levels" />
                                                    <TextBox Width="120"
                                                             Height="23"
                                                             VerticalAlignment="Center"
                                                             Text="{Binding BracingLevels, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Label Width="150" Height="30" Content="Top Offset (mm)" />
                                                    <TextBox Width="120"
                                                             Height="23"
                                                             VerticalAlignment="Center"
                                                             Text="{Binding TopOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                    <Label Width="150" Height="30" Content="Bottom Offset (mm)" />
                                                    <TextBox Width="120"
                                                             Height="23"
                                                             VerticalAlignment="Center"
                                                             Text="{Binding BottomOffset, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Model Points">
                            <Grid Margin="10">
                                <TextBlock Text="Model Points content goes here."
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           Foreground="#666666" />
                            </Grid>
                        </TabItem>

                        <TabItem Header="Joints">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <GroupBox Header="Splice Connection Parameters"
                                              Margin="0,0,0,10"
                                              FontSize="14"
                                              FontWeight="SemiBold"
                                              Width="736">
                                        <StackPanel Margin="10">
                                            <TextBlock Text="L-Parallel Splice Configuration"
                                                       FontSize="12"
                                                       FontWeight="Normal"
                                                       Foreground="#666666"
                                                       Margin="0,0,0,10" />

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Label Width="150"
                                                       Height="30"
                                                       VerticalAlignment="Center"
                                                       Content="Splice Plate Profile" />
                                                <UIControls:WpfFilterCheckBox Width="24"
                                                                              VerticalAlignment="Center"
                                                                              AttributeName="spliceprofile" />
                                                <TextBox Width="120"
                                                         Height="23"
                                                         Margin="6,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Text="{Binding SplicePlateProfile, Mode=TwoWay}"
                                                         TextWrapping="Wrap" />
                                                <UIControls:WpfProfileCatalog x:Name="splicePlateProfileCatalog"
                                                                              VerticalAlignment="Center"
                                                                              SelectClicked="splicePlateProfileCatalog_SelectClicked"
                                                                              SelectionDone="splicePlateProfileCatalog_SelectionDone" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Label Width="150"
                                                       Height="30"
                                                       VerticalAlignment="Center"
                                                       Content="Splice Plate Material" />
                                                <UIControls:WpfFilterCheckBox Width="24"
                                                                              VerticalAlignment="Center"
                                                                              AttributeName="splicematerial" />
                                                <TextBox Width="120"
                                                         Height="23"
                                                         Margin="6,0,6,0"
                                                         VerticalAlignment="Center"
                                                         Text="{Binding SplicePlateMaterial, Mode=TwoWay}"
                                                         TextWrapping="Wrap" />
                                                <UIControls:WpfMaterialCatalog x:Name="splicePlateMaterialCatalog"
                                                                               VerticalAlignment="Center"
                                                                               BorderThickness="0"
                                                                               FontSize="6"
                                                                               SelectClicked="splicePlateMaterialCatalog_SelectClicked"
                                                                               SelectionDone="splicePlateMaterialCatalog_SelectionDone" />
                                            </StackPanel>

                                            <Separator Margin="0,10,0,10" />

                                            <TextBlock Text="Bolt Configuration"
                                                       FontSize="12"
                                                       FontWeight="Normal"
                                                       Foreground="#666666"
                                                       Margin="0,0,0,10" />

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Label Width="150"
                                                       Height="30"
                                                       VerticalAlignment="Center"
                                                       Content="Bolt Size" />
                                                <UIControls:WpfFilterCheckBox Width="24"
                                                                              VerticalAlignment="Center"
                                                                              AttributeName="boltsize" />
                                                <UIControls:WpfBoltCatalogSize x:Name="boltSizeCatalog"
                                                                               Width="120"
                                                                               Height="23"
                                                                               Margin="6,0,6,0"
                                                                               VerticalAlignment="Center"
                                                                               AttributeName="boltsize" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Label Width="150" Height="30" Content="Bolt Standard" />
                                                <UIControls:WpfFilterCheckBox Width="24"
                                                                              VerticalAlignment="Center"
                                                                              AttributeName="boltstandard" />
                                                <UIControls:WpfBoltCatalogStandard x:Name="boltStandardCatalog"
                                                                                   Width="120"
                                                                                   Height="23"
                                                                                   Margin="6,0,6,0"
                                                                                   VerticalAlignment="Center"
                                                                                   AttributeName="boltstandard" />
                                            </StackPanel>

                                            <Separator Margin="0,10,0,10" />

                                            <TextBlock Text="Splice Dimensions"
                                                       FontSize="12"
                                                       FontWeight="Normal"
                                                       Foreground="#666666"
                                                       Margin="0,0,0,10" />

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Label Width="150" Height="30" Content="Plate Length (mm)" />
                                                <TextBox Width="120"
                                                         Height="23"
                                                         VerticalAlignment="Center"
                                                         Text="{Binding SplicePlateLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Label Width="150" Height="30" Content="Bolt Rows" />
                                                <TextBox Width="120"
                                                         Height="23"
                                                         VerticalAlignment="Center"
                                                         Text="{Binding BoltRows, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Label Width="150" Height="30" Content="Bolts Per Row" />
                                                <TextBox Width="120"
                                                         Height="23"
                                                         VerticalAlignment="Center"
                                                         Text="{Binding BoltsPerRow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Label Width="150" Height="30" Content="Bolt Spacing X (mm)" />
                                                <TextBox Width="120"
                                                         Height="23"
                                                         VerticalAlignment="Center"
                                                         Text="{Binding BoltSpacingX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <Label Width="150" Height="30" Content="Bolt Spacing Y (mm)" />
                                                <TextBox Width="120"
                                                         Height="23"
                                                         VerticalAlignment="Center"
                                                         Text="{Binding BoltSpacingY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                <Label Width="150" Height="30" Content="Edge Distance (mm)" />
                                                <TextBox Width="120"
                                                         Height="23"
                                                         VerticalAlignment="Center"
                                                         Text="{Binding EdgeDistance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </Grid>

                <Border Grid.Row="2"
                        Background="#F5F5F5"
                        CornerRadius="0,0,15,15"
                        Padding="10">
                    <UIControls:WpfOkApplyModifyGetOnOffCancel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="760"
                        ApplyClicked="WPFOkApplyModifyGetOnOffCancel_ApplyClicked"
                        CancelClicked="WPFOkApplyModifyGetOnOffCancel_CancelClicked"
                        GetClicked="WPFOkApplyModifyGetOnOffCancel_GetClicked"
                        ModifyClicked="WPFOkApplyModifyGetOnOffCancel_ModifyClicked"
                        OkClicked="WPFOkApplyModifyGetOnOffCancel_OkClicked"
                        OnOffClicked="WPFOkApplyModifyGetOnOffCancel_OnOffClicked">
                        <UIControls:WpfOkApplyModifyGetOnOffCancel.Resources>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#0078D4" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="15,8" />
                                <Setter Property="Margin" Value="5,0" />
                                <Setter Property="MinWidth" Value="80" />
                                <Setter Property="MinHeight" Value="32" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#005A9E" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#004578" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#CCCCCC" />
                                        <Setter Property="Foreground" Value="#666666" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </UIControls:WpfOkApplyModifyGetOnOffCancel.Resources>
                    </UIControls:WpfOkApplyModifyGetOnOffCancel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</tsd:PluginWindowBase>