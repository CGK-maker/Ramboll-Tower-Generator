using System;
using System.Collections.Generic;
using System.Windows.Forms;
using RambollTowerGenerator.Builders;
using RambollTowerGenerator.Common;
using RambollTowerGenerator.Models;
using Tekla.Structures.Geometry3d;
using Tekla.Structures.Model;
using Tekla.Structures.Model.UI;
using Tekla.Structures.Plugins;

namespace RambollTowerGenerator
{
    [Plugin("TowerGenerator")]
    [PluginUserInterface("RambollTowerGenerator.Views.MainWindow")]
    public class TowerPlugin : PluginBase
    {
        private Model _Model;
        private TowerPluginData _Data;

        public Model Model
        {
            get { return _Model; }
            set { _Model = value; }
        }

        public TowerPluginData Data
        {
            get { return _Data; }
            set { _Data = value; }
        }

        public TowerPlugin(TowerPluginData data)
        {
            Model = new Model();
            Data = data;
        }

        public override List<InputDefinition> DefineInput()
        {
            var inputs = new List<InputDefinition>();
            var picker = new Picker();
            Point basePoint = picker.PickPoint("Pick tower base center point");
            inputs.Add(new InputDefinition(basePoint));
            return inputs;
        }

        public override bool Run(List<InputDefinition> Input)
        {
            try
            {
                Point basePoint = (Point)Input[0].GetInput();
                TowerModel tower = BuildTowerModel(basePoint);

                var legBuilder = new LegBuilder();
                legBuilder.CreateLegs(Model, tower);

                // Create bracing if enabled
                if (tower.Bracing.BracingType != BracingType.None)
                {
                    var bracingBuilder = new BracingBuilder();
                    bracingBuilder.CreateBracing(Model, tower);
                }

                // Create splice connections at segment joints
                if (tower.Geometry.SegmentGap > 0.0)
                {
                    var jointBuilder = new JointBuilder();
                    jointBuilder.CreateSpliceConnections(Model, tower);
                }
            }
            catch (Exception exc)
            {
                MessageBox.Show(exc.ToString());
                return false;
            }

            return true;
        }

        private TowerModel BuildTowerModel(Point basePoint)
        {
            var tower = new TowerModel();
            tower.BasePoint = basePoint;
            tower.TowerType = Data.TowerType == 0 ? TowerType.ThreeLeg : TowerType.FourLeg;
            tower.Profile.LegProfile = IsDefaultValue(Data.profile) ? "BLL100*100*5" : Data.profile;
            tower.Profile.LegMaterial = IsDefaultValue(Data.material) ? "STEEL_UNDEFINED" : Data.material;

            tower.Geometry.BaseWidth = IsDefaultValue(Data.basewidth) || Data.basewidth <= 0 ? 5000.0 : Data.basewidth;
            tower.Geometry.TopWidth = IsDefaultValue(Data.topwidth) || Data.topwidth <= 0 ? 2400.0 : Data.topwidth;
            tower.Geometry.SegmentCount = IsDefaultValue(Data.segmentcount) || Data.segmentcount < 1 ? 6 : Data.segmentcount;
            tower.Geometry.TotalHeight = IsDefaultValue(Data.totalheight) || Data.totalheight <= 0 ? 30000.0 : Data.totalheight;
            tower.Geometry.SegmentGap = IsDefaultValue(Data.segmentgap) || Data.segmentgap < 0 ? 3.0 : Data.segmentgap;

            tower.Cage.CageType = Data.cagetype == 1 ? CageType.Vertical : (Data.cagetype == 2 ? CageType.ConicalVertical : CageType.Conical);
            tower.Cage.VerticalHeight = IsDefaultValue(Data.verticalheight) || Data.verticalheight < 0 ? 0.0 : Data.verticalheight;
            tower.Cage.VerticalSegmentCount = IsDefaultValue(Data.verticalsegmentcount) || Data.verticalsegmentcount < 1 ? 2 : Data.verticalsegmentcount;

            // Bracing configuration
            tower.Bracing.BracingType = Data.bracingtype == 0 ? BracingType.None :
                (Data.bracingtype == 1 ? BracingType.XBracing :
                (Data.bracingtype == 2 ? BracingType.KBracing : BracingType.VBracing));
            tower.Bracing.DiagonalProfile = IsDefaultValue(Data.diagprofile) ? "BLL100*100*5" : Data.diagprofile;
            tower.Bracing.DiagonalMaterial = IsDefaultValue(Data.diagmaterial) ? "STEEL_UNDEFINED" : Data.diagmaterial;
            tower.Bracing.HorizontalProfile = IsDefaultValue(Data.horizprofile) ? "BLL100*100*5" : Data.horizprofile;
            tower.Bracing.HorizontalMaterial = IsDefaultValue(Data.horizmaterial) ? "STEEL_UNDEFINED" : Data.horizmaterial;
            tower.Bracing.BracingLevels = IsDefaultValue(Data.bracinglevels) || Data.bracinglevels < 1 ? 3 : Data.bracinglevels;
            tower.Bracing.TopOffset = IsDefaultValue(Data.topoffset) || Data.topoffset < 0 ? 100.0 : Data.topoffset;
            tower.Bracing.BottomOffset = IsDefaultValue(Data.bottomoffset) || Data.bottomoffset < 0 ? 100.0 : Data.bottomoffset;

            // Joint/Splice configuration
            tower.Joint.SplicePlateProfile = IsDefaultValue(Data.spliceprofile) ? "PL200*10" : Data.spliceprofile;
            tower.Joint.SplicePlateMaterial = IsDefaultValue(Data.splicematerial) ? "STEEL_UNDEFINED" : Data.splicematerial;
            tower.Joint.BoltSize = IsDefaultValue(Data.boltsize) ? "M16" : Data.boltsize;
            tower.Joint.BoltStandard = IsDefaultValue(Data.boltstandard) ? "8.8" : Data.boltstandard;
            tower.Joint.SplicePlateLength = IsDefaultValue(Data.spliceplatelength) || Data.spliceplatelength <= 0 ? 400.0 : Data.spliceplatelength;
            tower.Joint.BoltRows = IsDefaultValue(Data.boltrows) || Data.boltrows < 1 ? 2 : Data.boltrows;
            tower.Joint.BoltsPerRow = IsDefaultValue(Data.boltsperrow) || Data.boltsperrow < 1 ? 2 : Data.boltsperrow;
            tower.Joint.BoltSpacingX = IsDefaultValue(Data.boltspacingx) || Data.boltspacingx <= 0 ? 60.0 : Data.boltspacingx;
            tower.Joint.BoltSpacingY = IsDefaultValue(Data.boltspacingy) || Data.boltspacingy <= 0 ? 80.0 : Data.boltspacingy;
            tower.Joint.EdgeDistance = IsDefaultValue(Data.edgedistance) || Data.edgedistance <= 0 ? 40.0 : Data.edgedistance;

            return tower;
        }
    }
}
