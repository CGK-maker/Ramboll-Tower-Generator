            _towerModel.Cage.VerticalHeight = _verticalHeight;
            _towerModel.Cage.VerticalSegmentCount = _verticalSegmentCount;

            // Initialize bracing properties
            _towerModel.Bracing.BracingType = Common.BracingType.XBracing;
            _towerModel.Bracing.DiagonalProfile = _diagonalProfile;
            _towerModel.Bracing.DiagonalMaterial = _diagonalMaterial;
            _towerModel.Bracing.HorizontalProfile = _horizontalProfile;
            _towerModel.Bracing.HorizontalMaterial = _horizontalMaterial;
            _towerModel.Bracing.BracingLevels = _bracingLevels;
            _towerModel.Bracing.TopOffset = _topOffset;
            _towerModel.Bracing.BottomOffset = _bottomOffset;

            // Initialize joint/splice properties
            _towerModel.Joint.SplicePlateProfile = _splicePlateProfile;
            _towerModel.Joint.SplicePlateMaterial = _splicePlateMaterial;
            _towerModel.Joint.BoltSize = _boltSize;
            _towerModel.Joint.BoltStandard = _boltStandard;
            _towerModel.Joint.SplicePlateLength = _splicePlateLength;
